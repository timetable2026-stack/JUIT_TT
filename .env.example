# --- Admin ---
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_SECRET=a-long-random-string-used-to-sign-the-admin-cookie

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://timetable.juitsolan.ac.in
NEXT_PUBLIC_DEPARTMENT_NAME=Time Table Committee (TTC)
NEXT_PUBLIC_INSTITUTE_NAME=Jaypee University of Information Technology, Solan

# --- Database (Supabase project > Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Leave both blank to use the local JSON file store in ./data (development only, not for Vercel)

# --- Email: option A, send from the office mailbox itself (recommended, no DNS needed) ---
# Google Workspace / Gmail: create an App Password at myaccount.google.com/apppasswords (2-step verification must be on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=timetable2026@juitsolan.in
SMTP_PASS=xxxx xxxx xxxx xxxx
# --- Email: option B, Resend (domain must be verified in Resend) ---
# RESEND_API_KEY=re_...
# Sender shown to faculty (defaults to the office mailbox):
EMAIL_FROM="JUIT Time Table Committee <timetable2026@juitsolan.in>"
EMAIL_REPLY_TO=timetable2026@juitsolan.in
